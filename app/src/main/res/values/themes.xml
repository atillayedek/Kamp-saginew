<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KampusAgi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kampusagi_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.KampusAgi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kampusagi_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.KampusAgi</item>
    </style>
</resources>
