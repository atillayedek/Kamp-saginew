# Names only. Values live in Vercel project settings or .env.local (never committed).
# Supabase project URL and the publishable (sb_publishable_...) or anon key. Never a secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: Google Play listing and privacy policy links shown on the landing page.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_PRIVACY_POLICY_URL=
